{
    "name": "seidan/backend",
    "description": "PHP API pour le projet Worldbuilding",
    "type": "project",
    "license": "proprietary",
    "autoload": {
        "classmap": [
            "controllers/",
            "core/",
            "models/"
        ],
        "files": [
            "config/env.php",
            "config/database.php",
            "routes/admin.php",
            "routes/auth.php",
            "routes/filters.php",
            "routes/links.php",
            "routes/moderation.php",
            "routes/owned-pages.php",
            "routes/pages.php"
        ]
    },
    "authors": [
        {
            "name": "Dylan",
            "email": "dylan.blanc@laplateforme.io"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "aws/aws-sdk-php": "^3.0",
        "getbrevo/brevo-php": "^5.0",
        "guzzlehttp/guzzle": "^7.15"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
